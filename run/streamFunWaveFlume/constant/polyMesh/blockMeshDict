FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


convertToMeters 1;

x0		0;
x1		50;

y0 		-.1;
y1		.1;

z0		-1;
z1		1;

vertices
(
    ($x0 $y0 $z0)
    ($x1 $y0 $z0)
    ($x1 $y1 $z0)
    ($x0 $y1 $z0)
    ($x0 $y0 $z1)
    ($x1 $y0 $z1)
    ($x1 $y1 $z1)
    ($x0 $y1 $z1)
);

nx		500;

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nx 1 20) simpleGrading (1 1 1)
);

edges
(
);

patches
(
    patch left
    (
       	(0 4 7 3)
    )
    patch right
    (
        (1 2 6 5)
    )
    patch bottom
    (
       	(3 2 1 0)
    )
    patch top
    (
       	(4 5 6 7)
    )
    empty frontAndBack
    (
	(0 1 5 4)
        (2 3 7 6)
    )	
);

mergePatchPairs
();


