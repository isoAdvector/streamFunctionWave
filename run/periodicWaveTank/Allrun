#!/bin/bash

cp system/controlDict.init system/controlDict
nProc=$(sed -ne "s/^numberOfSubdomains *\(.*\);/\1/p" system/decomposeParDict)
application=$(sed -ne "s/^application *\(.*\);/\1/p" system/controlDict)
jobStart=$(date +"%Y%m%d%H%M")

if [ ! -d "logs" ]; then
        mkdir logs
        cp -r 0.org 0
        blockMesh > logs/blockMesh.log 2>&1
        topoSet -dict system/topoSetDict0 > logs/topoSetDict0.log 2>&1
        refineMesh -dict system/refineMeshDict -overwrite > logs/refineMeshDict.log 2>&1

        topoSet -dict system/topoSetDict1 > logs/topoSetDict1.log 2>&1
        refineMesh -dict system/refineMeshDict -overwrite > logs/refineMeshDict.log 2>&1

        streamFunFoam > logs/streamFunFoam.log 2>&1
        cp 0/alpha1 0/alpha.water
        sed -i 's/alpha1/alpha.water/g' 0/alpha.water
        cp 0.org/p_rgh 0/p_rgh
        cp system/controlDict.run system/controlDict
else
        mv logs logs_$jobStart
        mkdir logs
fi


if [ "$nProc" -gt "1" ];
then
        if [ ! -d "processor0" ]; then
                decomposePar > logs/decomposePar.log 2>&1
        fi
        mpirun -np $nProc $application -parallel > logs/$application.log 2>&1
else
        application=$(sed -ne "s/^application *\(.*\);/\1/p" system/controlDict)
        $application > logs/$application.log 2>&1
fi
