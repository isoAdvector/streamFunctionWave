cd "${0%/*}" || exit 1
#------------------------------------------------------------------------------
# Tests of streamFunctionWave, after ./Allwmake, with OpenFOAM sourced:
#   fourier  fenton.py, an independent implementation of Fenton's Fourier
#            method, against linear theory and Stokes waves; and
#            calcStreamFunctionWave against fenton.py for each input type
#   requests random waves over the range of the table, each against the
#            same wave with a 1000 times smaller tolerance
#   figures  waves at three depths, from low to the highest of the table, at
#            three tolerances: the residuals of the surface conditions,
#            evaluated independently of the C++ code, against the
#            tolerance; writes the figures of the README to ../doc
#   cases    the example cases in ../run, for 0.2 s each
#   fields   the initial velocity of streamFunFoam against the wave
#   binary   waveFlume written in binary and restarted from binary fields
#   parallel waveFlume decomposed, run on 2 cores, reconstructed and
#            converted to VTK: the results equal the serial ones, and the
#            utilities calculate the wave once per mesh, not per field or
#            time
# Work directories are in work/. Takes a few minutes.
#------------------------------------------------------------------------------

[ -n "$WM_PROJECT_DIR" ] || { echo "Source the OpenFOAM environment first" >&2; exit 1; }

fails=0
mkdir -p work

# Report case $1 in work directory $2: ok if every log but log.Allrun ends
# normally and time directory $3 exists
check()
{
    bad=$(for l in "$2"/log.*; do
              [ "$l" = "$2/log.Allrun" ] && continue
              tail -3 "$l" | grep -q -E '^(End|Finalising)' || basename "$l"
          done)
    if [ -z "$bad" ] && [ -d "$2/$3" ]
    then
        echo "$1: ok"
    else
        echo "$1: FAILED ${bad:-no $3 time directory}"
        fails=$((fails + 1))
    fi
}

echo "=== fourier: fenton.py against linear theory and Stokes waves"
python3 fourier/fenton.py || fails=$((fails + 1))

echo
echo "=== fourier: calcStreamFunctionWave against fenton.py"
python3 fourier/compare.py work/fourier || fails=$((fails + 1))

echo
echo "=== requests: random waves against the same waves to a 1000 times smaller tolerance"
mkdir -p work/requests
if wmake -s requests > work/requests/log.wmake 2>&1
then
    Test-streamFunctionWaveRequests -n 60 > work/requests/log.requests 2>&1
    tail -3 work/requests/log.requests
    grep -q "^60 of 60 requests ok" work/requests/log.requests \
        || { echo "requests: FAILED, see work/requests/log.requests"; fails=$((fails + 1)); }
else
    echo "requests: FAILED to build, see work/requests/log.wmake"
    fails=$((fails + 1))
fi

echo
echo "=== figures: residuals of the surface conditions, and the figures in ../doc"
python3 figures.py work/figures ../doc > work/figures.log 2>&1 \
    || { tail -20 work/figures.log; fails=$((fails + 1)); }
tail -1 work/figures.log

echo
echo "=== cases: the example cases in ../run, 0.2 s each"
for case in ../run/*/
do
    name=$(basename "$case")
    w=work/cases/$name
    rm -rf "$w"
    mkdir -p work/cases
    cp -r "$case" "$w"
    # The run, not the initialisation by streamFunFoam in controlDict.init
    for dict in "$w"/system/controlDict "$w"/system/controlDict.run
    do
        [ -f "$dict" ] || continue
        grep -q '^deltaT *0;' "$dict" && [ "$dict" = "$w/system/controlDict" ] \
            && [ -f "$w/system/controlDict.run" ] && continue
        foamDictionary -entry endTime -set 0.2 "$dict" > /dev/null 2>&1
    done
    (cd "$w" && ./Allrun > log.Allrun 2>&1)
    check "$name" "$w" 0.2
done

echo
echo "=== fields: initial velocity of streamFunFoam against the wave in the water cells"
for case in work/cases/*/
do
    [ -f "$case"/log.streamFunFoam ] || continue
    # Cell centres to full precision, the fields themselves have 6 digits
    foamDictionary -entry writePrecision -set 15 "$case"/system/controlDict > /dev/null 2>&1
    (cd "$case" && postProcess -func writeCellCentres -time 0 > log.writeCellCentres 2>&1)
    coeffs=work/coeffs_$(basename "$case")
    calcStreamFunctionWave "$case"/constant/waveProperties "$coeffs" > /dev/null 2>&1
    python3 fields.py "$case" "$coeffs" || fails=$((fails + 1))
done

echo
echo "=== binary: waveFlume in binary to 0.1 s, then restarted to 0.2 s"
w=work/cases/waveFlume_binary
rm -rf "$w"
cp -r ../run/waveFlume "$w"
foamDictionary -entry writeFormat -set binary "$w"/system/controlDict > /dev/null 2>&1
foamDictionary -entry endTime -set 0.1 "$w"/system/controlDict > /dev/null 2>&1
(cd "$w" && ./Allrun > log.Allrun 2>&1)
foamDictionary -entry endTime -set 0.2 "$w"/system/controlDict > /dev/null 2>&1
app=$(foamDictionary -entry application -value "$w"/system/controlDict)
(cd "$w" && $app > log.restart 2>&1)
check waveFlume_binary "$w" 0.2

echo
echo "=== parallel: waveFlume on 2 cores, reconstructPar and foamToVTK"
w=work/cases/waveFlume_parallel
rm -rf "$w"
mkdir -p "$w"
cp -r work/cases/waveFlume/{0,constant,system} "$w"
rm -rf "$w"/0/uniform
foamDictionary -entry numberOfSubdomains -set 2 "$w"/system/decomposeParDict > /dev/null 2>&1
foamDictionary -entry method -set scotch "$w"/system/decomposeParDict > /dev/null 2>&1
app=$(foamDictionary -entry application -value "$w"/system/controlDict)
(
    cd "$w" || exit
    decomposePar > log.decomposePar 2>&1
    mpirun -np 2 $app -parallel > log.parallel 2>&1
    reconstructPar > log.reconstructPar 2>&1
    foamToVTK > log.foamToVTK 2>&1
)
check waveFlume_parallel "$w" 0.2
# Number of wave calculations in each log
calcs()
{
    grep -c "^Calculating streamFunctionWave:" "$w/log.$1"
}
if [ "$(calcs decomposePar)" = 1 ] && [ "$(calcs parallel)" = 1 ] \
&& [ "$(calcs reconstructPar)" = 2 ] && [ "$(calcs foamToVTK)" = 1 ]
then
    echo "parallel: wave calculated once per mesh"
else
    echo "parallel: FAILED, wave calculations decomposePar $(calcs decomposePar)," \
         "solver $(calcs parallel), reconstructPar $(calcs reconstructPar)," \
         "foamToVTK $(calcs foamToVTK); expected 1, 1, 2, 1"
    fails=$((fails + 1))
fi
# The reconstructed fields against the serial run of the cases section
python3 - "$w" work/cases/waveFlume <<'PYEOF' || fails=$((fails + 1))
import re, sys
def values(case, field):
    text = open(f"{case}/0.2/{field}").read()
    return [float(v) for v in re.findall(r"[-+]?\d[\d.eE+-]*", text.split("internalField", 1)[1])]
bad = 0
for field in ("U", "alpha.water"):
    a, b = values(sys.argv[1], field), values(sys.argv[2], field)
    d = max(abs(x - y) for x, y in zip(a, b)) if len(a) == len(b) else float("inf")
    print(f"parallel: {field} at 0.2 s, max difference to serial {d:.3g}")
    bad += not d < 1e-3
sys.exit(bad)
PYEOF

echo
[ $fails = 0 ] && echo "ALL TESTS PASSED" || echo "$fails TESTS FAILED"
exit $fails

#------------------------------------------------------------------------------
